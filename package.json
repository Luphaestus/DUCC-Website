{
  "name": "ducc-website",
  "version": "1.0.0",
  "description": "DUCC Website (uni assignment)",
  "homepage": "https://github.com/Luphaestus/DUCC-Website#readme",
  "bugs": {
    "url": "https://github.com/Luphaestus/DUCC-Website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Luphaestus/DUCC-Website.git"
  },
  "license": "Apache-2.0",
  "author": "Luphaestus",
  "type": "module",
  "scripts": {
    "db:init": "cross-env-shell \"tsx server/db/init/init.ts $NODE_ENV $1\"",
    "reseed": "cross-env NODE_ENV=dev tsx server/db/init/init.ts dev --seed",
    "start": "cross-env NODE_ENV=prod npm run --silent db:init && npm run build:client && cross-env NODE_ENV=prod tsx server/server.ts",
    "build:client": "vite build",
    "build:client:watch": "vite build --mode development --watch",
    "sass": "sass src/styles.scss public/assets/main.css --watch",
    "dev:server": "cross-env NODE_ENV=dev nodemon --quiet --exec tsx server/server.ts",
    "dev": "cross-env NODE_ENV=dev npm run --silent db:init && cross-env NODE_ENV=dev run-p --silent build:client:watch dev:server",
    "dev:seed": "cross-env NODE_ENV=dev tsx server/db/init/init.ts dev --seed && cross-env NODE_ENV=dev run-p --silent sass dev:server",
    "pretest": "cross-env NODE_ENV=test tsx server/db/init/init.ts test --seed",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test DATABASE_PATH=data/database.test.db vitest",
    "apidoc": "npx openapi-generate-html -i public/openapi.json --theme=dark --ui stoplight --theme dark -o public/openapi.html",
    "prepare": "husky install"
  },
  "lint-staged": {
    "public/openapi.json": [
      "npm run apidoc",
      "git add public/openapi.html"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "server/"
    ],
    "ext": "js,json,ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/passport": "^3.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^8.0.4",
    "@picocss/pico": "^2.1.1",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@solid-devtools/overlay": "^0.33.5",
    "@solidjs/router": "^0.15.4",
    "ansi-colors": "^4.1.3",
    "bcrypt": "^6.0.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.2.1",
    "file-type": "^21.3.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "mysql2": "^3.9.0",
    "otplib": "^13.2.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sass": "^1.94.0",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@fastify/middie": "^9.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.2.0",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "husky": "^8.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.17"
  }
}
